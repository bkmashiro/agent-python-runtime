{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/tool-response.schema.json",
  "title": "Agent Python Runtime Host Tool Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["call_id", "status", "result", "error"],
  "properties": {
    "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["ok", "denied", "error", "timeout"]},
    "result": {},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 128},
            "message": {"type": "string", "maxLength": 4096}
          }
        }
      ]
    }
  }
}
