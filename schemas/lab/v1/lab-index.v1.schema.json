{
  "$id": "https://agent-runtime.dev/lab/v1/lab-index.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded privacy-safe read projection; not authority and not LabStore disk format.",
  "properties": {
    "capabilities": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "branch_dag"
        },
        {
          "const": "comparison"
        },
        {
          "const": "timeline"
        },
        {
          "const": "workspace_diff"
        }
      ],
      "type": "array"
    },
    "generated_at_policy": {
      "const": "omitted"
    },
    "links": {
      "maxItems": 8,
      "minItems": 8,
      "prefixItems": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "study-summary.v1"
            },
            "rel": {
              "const": "study"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "run-detail.v1"
            },
            "rel": {
              "const": "run"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timeline-page.v1"
            },
            "rel": {
              "const": "timeline"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "branch-dag.v1"
            },
            "rel": {
              "const": "branch"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workspace-diff.v1"
            },
            "rel": {
              "const": "workspace"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "run-comparison.v1"
            },
            "rel": {
              "const": "comparison"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "object-ref.v1"
            },
            "rel": {
              "const": "reference"
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
