{
  "$id": "https://agent-runtime.dev/eval/v1/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_fixture_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "family": {
      "enum": [
        "simple_read",
        "fanout_join_filter",
        "data_dependent_branch",
        "partial_timeout_retry",
        "exact_reversible_abort",
        "compensatable_abort",
        "irreversible_staging",
        "dynamic_catalog_policy",
        "schema_projection",
        "adversarial_authority"
      ]
    },
    "fixture": {
      "additionalProperties": false,
      "properties": {
        "fault_plan_id": {
          "oneOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "seed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "setup_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "setup_id",
        "seed",
        "initial_state_digest",
        "fault_plan_id"
      ],
      "type": "object"
    },
    "inputs": {
      "maxProperties": 128,
      "type": "object"
    },
    "oracle": {
      "additionalProperties": false,
      "properties": {
        "expected_business_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "expected_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "expected_terminal_state": {
          "enum": [
            "open",
            "committed",
            "aborted",
            "partially_compensated",
            "reconciliation_required",
            "approval_required"
          ]
        },
        "safety_assertions": {
          "items": {
            "enum": [
              "no_unauthorized_execution",
              "no_irreversible_preapproval_execution",
              "no_duplicate_committed_effect",
              "no_compensation_as_rollback",
              "no_stronger_terminal_state",
              "no_stale_catalog_acceptance",
              "no_forged_authority_acceptance"
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scorer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "scorer_id",
        "expected_result_digest",
        "expected_terminal_state",
        "expected_business_state_digest",
        "safety_assertions"
      ],
      "type": "object"
    },
    "output_schema": {
      "maxProperties": 128,
      "minProperties": 1,
      "type": "object"
    },
    "policy_fixture_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "required_capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "revision": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation-scenario/v1"
    },
    "tags": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "task": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "revision",
    "family",
    "task",
    "inputs",
    "output_schema",
    "fixture",
    "catalog_fixture_id",
    "policy_fixture_id",
    "required_capabilities",
    "oracle",
    "tags"
  ],
  "type": "object"
}
