{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bkmashiro/agent-python-runtime/benchmark/v1/prepared-evidence.schema.json",
  "title": "Agent Python Runtime single-use prepared benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "evidence_class", "artifact", "host_source", "backend", "environment", "fixture", "compile_once", "readiness", "state_copy", "workloads", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_kind": {"enum": ["single-use-preinitialized", "cow-ready-single-use"]},
    "evidence_class": {"enum": ["production-safe", "full", "profile-candidate"]},
    "artifact": {"$ref": "#/$defs/artifact"},
    "host_source": {"$ref": "#/$defs/hostSource"},
    "backend": {"$ref": "#/$defs/backend"},
    "environment": {"$ref": "#/$defs/environment"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "capability_operations", "provider_delay_ns_per_operation", "prepared_capacity"],
      "properties": {
        "workload": {"enum": ["basic", "numpy-import", "numpy-ready"]},
        "cow_warmup_profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "samples": {"type": "integer", "minimum": 3, "maximum": 20},
        "capability_operations": {"type": "integer", "minimum": 1, "maximum": 20},
        "provider_delay_ns_per_operation": {"const": 2000000},
        "prepared_capacity": {"const": 1}
      }
    },
    "compile_once": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantiate_host_ns", "compile_ns"],
      "properties": {
        "instantiate_host_ns": {"type": "integer", "minimum": 1},
        "compile_ns": {"type": "integer", "minimum": 1}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_new_total_ns", "instantiate_guest_ns", "_initialize_ns", "runtime_init_ns", "ready_instances", "retained_guest_memory_bytes"],
      "properties": {
        "factory_new_total_ns": {"type": "integer", "minimum": 1},
        "instantiate_guest_ns": {"type": "integer", "minimum": 1},
        "_initialize_ns": {"type": "integer", "minimum": 1},
        "runtime_init_ns": {"type": "integer", "minimum": 1},
        "attach_host_calls_ns": {"type": "integer", "minimum": 1},
        "warmup_ns": {"type": "integer", "minimum": 1},
        "seal_ns": {"type": "integer", "minimum": 1},
        "initial_slot_instantiate_ns": {"type": "integer", "minimum": 1},
        "initial_slot__initialize_ns": {"type": "integer", "minimum": 1},
        "initial_slot_cow_restore_ns": {"type": "integer", "minimum": 1},
        "initial_slot_attach_globals_ns": {"type": "integer", "minimum": 1},
        "initial_slot_attach_host_calls_ns": {"type": "integer", "minimum": 1},
        "ready_instances": {"const": 1},
        "retained_guest_memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "prepared_image": {"$ref": "#/$defs/preparedImage"},
    "state_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "reason"],
      "properties": {
        "applicable": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_execute", "steady_execute", "steady_capability"],
      "properties": {
        "first_execute": {"$ref": "#/$defs/executeSample"},
        "steady_execute": {"type": "array", "minItems": 3, "maxItems": 20, "items": {"$ref": "#/$defs/executeSample"}},
        "steady_capability": {"type": "array", "minItems": 3, "maxItems": 20, "items": {"$ref": "#/$defs/capabilitySample"}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "profile-candidate"}}},
      "then": {"properties": {"artifact": {"required": ["artifact_profile"], "properties": {"artifact_profile": {"const": "numpy-core"}}}}}
    },
    {
      "if": {"properties": {"evidence_class": {"enum": ["production-safe", "full"]}}},
      "then": {"properties": {"artifact": {"properties": {"artifact_profile": {"const": "base"}}}}}
    }
  ],
  "$defs": {
    "preparedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "virtual_bytes", "allocated_bytes", "page_size_bytes", "zero_pages", "non_zero_pages", "sparse_potential_bytes"],
      "properties": {
        "available": {"type": "boolean"},
        "virtual_bytes": {"type": "integer", "minimum": 0},
        "allocated_bytes": {"type": "integer", "minimum": 0},
        "page_size_bytes": {"type": "integer", "minimum": 0},
        "zero_pages": {"type": "integer", "minimum": 0},
        "non_zero_pages": {"type": "integer", "minimum": 0},
        "sparse_potential_bytes": {"type": "integer", "minimum": 0},
        "warmup_profile": {"type": "string", "minLength": 1},
        "warmup_generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes", "source_commit", "target", "execution_model"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_profile": {"enum": ["base", "numpy-core"]},
        "target": {"const": "wasm32-wasip1"},
        "execution_model": {"const": "reactor"}
      }
    },
    "hostSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "modified": {"const": false}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reset_mode"],
      "properties": {
        "name": {"const": "wazero"},
        "reset_mode": {"const": "fresh-instance"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "go_version"],
      "properties": {
        "goos": {"type": "string", "minLength": 1},
        "goarch": {"type": "string", "minLength": 1},
        "go_version": {"type": "string", "minLength": 1}
      }
    },
    "sampleBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execute_ns", "capability_ns", "run_total_ns", "refill_instantiate_guest_ns", "refill__initialize_ns", "refill_ready_after_run_ns", "request_bytes", "result_bytes", "retained_guest_memory_bytes"],
      "properties": {
        "pool_hit_ns": {"type": "integer", "minimum": 1},
        "pool_wait_ns": {"type": "integer", "minimum": 1},
        "prepare_ns": {"type": "integer", "minimum": 1},
        "source_validate_ns": {"type": "integer", "minimum": 1},
        "execute_ns": {"type": "integer", "minimum": 1},
        "capability_ns": {"type": "integer", "minimum": 0},
        "run_total_ns": {"type": "integer", "minimum": 1},
        "refill_instantiate_guest_ns": {"type": "integer", "minimum": 1},
        "refill__initialize_ns": {"type": "integer", "minimum": 1},
        "refill_runtime_init_ns": {"type": "integer", "minimum": 1},
        "refill_cow_restore_ns": {"type": "integer", "minimum": 1},
        "refill_attach_globals_ns": {"type": "integer", "minimum": 1},
        "refill_attach_host_calls_ns": {"type": "integer", "minimum": 1},
        "refill_ready_after_run_ns": {"type": "integer", "minimum": 0},
        "request_bytes": {"type": "integer", "minimum": 1},
        "result_bytes": {"type": "integer", "minimum": 1},
        "retained_guest_memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "executeSample": {
      "allOf": [
        {"$ref": "#/$defs/sampleBase"},
        {"properties": {"capability_ns": {"const": 0}}}
      ]
    },
    "capabilitySample": {
      "allOf": [
        {"$ref": "#/$defs/sampleBase"},
        {"properties": {"capability_ns": {"type": "integer", "minimum": 1}}}
      ]
    }
  }
}
