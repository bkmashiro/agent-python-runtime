{
  "$id": "https://agent-runtime.dev/abi/v1/effect-attempt-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "apply"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "expected_operation_state": {
            "enum": [
              "ready",
              "failed_retryable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rollback"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "expected_operation_state": {
            "enum": [
              "applied",
              "rollback_failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "compensate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "expected_operation_state": {
            "enum": [
              "compensation_required",
              "compensation_failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_receipt_digest": {
            "not": {
              "const": ""
            }
          }
        },
        "required": [
          "provider_receipt_digest"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect_class": {
            "const": "irreversible"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "effect_class",
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "minLength": 71
          }
        },
        "required": [
          "provider_receipt_digest"
        ]
      }
    }
  ],
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "expected_operation_state": {
      "enum": [
        "ready",
        "failed_retryable",
        "applied",
        "rollback_failed",
        "compensation_required",
        "compensation_failed"
      ]
    },
    "kind": {
      "enum": [
        "apply",
        "rollback",
        "compensate"
      ]
    },
    "lease_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "lease_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "ordinal": {
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "provider_request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "leased",
        "dispatching",
        "succeeded",
        "failed",
        "ambiguous",
        "expired"
      ]
    },
    "transaction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "provider_receipt_digest": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "reconciliation_digest": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "effect_class": {
      "enum": [
        "read_only",
        "reversible",
        "compensatable",
        "irreversible"
      ]
    }
  },
  "required": [
    "attempt_id",
    "transaction_id",
    "operation_id",
    "effect_class",
    "kind",
    "ordinal",
    "state",
    "expected_operation_state",
    "lease_id",
    "lease_expires_at",
    "provider_request_digest",
    "provider_receipt_digest",
    "reconciliation_digest",
    "version",
    "created_at",
    "updated_at"
  ],
  "type": "object"
}
