{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bkmashiro.github.io/agent-python-runtime/benchmark/v1/phase7-paired-density.schema.json",
  "title": "Phase 7 paired NumPy density summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "artifact", "warmup", "host_source", "backend", "environment", "plan", "source_evidence", "pairs", "summary_by_slots"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_class": {"const": "phase7-paired-density"},
    "artifact": {"type": "object"},
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "generation_sha256"],
      "properties": {
        "profile": {"const": "numpy-ready-v1"},
        "generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "host_source": {"type": "object"},
    "backend": {"type": "object"},
    "environment": {"type": "object"},
    "plan": {"type": "object"},
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cow_sha256", "non_cow_sha256"],
      "properties": {
        "cow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "non_cow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 140,
      "items": {"$ref": "#/$defs/pair"}
    },
    "summary_by_slots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/slotSummary"}
    }
  },
  "$defs": {
    "uint": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_shards", "ready_total_ns", "warmup_ns", "rss_bytes", "pss_bytes", "private_dirty_bytes"],
      "properties": {
        "runtime_shards": {"$ref": "#/$defs/positive"},
        "ready_total_ns": {"$ref": "#/$defs/positive"},
        "warmup_ns": {"$ref": "#/$defs/uint"},
        "rss_bytes": {"$ref": "#/$defs/uint"},
        "pss_bytes": {"$ref": "#/$defs/positive"},
        "private_dirty_bytes": {"$ref": "#/$defs/uint"},
        "cow_mapping_pss_bytes": {"$ref": "#/$defs/uint"}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "repeat", "cow", "non_cow", "derived"],
      "properties": {
        "slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 20},
        "cow": {
          "allOf": [
            {"$ref": "#/$defs/arm"},
            {"required": ["cow_mapping_pss_bytes"]}
          ]
        },
        "non_cow": {"$ref": "#/$defs/arm"},
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pss_saved_bytes", "pss_reduction_ppm", "non_cow_to_cow_ready_time_ppm"],
          "properties": {
            "pss_saved_bytes": {"type": "integer"},
            "pss_reduction_ppm": {"type": "integer"},
            "non_cow_to_cow_ready_time_ppm": {"$ref": "#/$defs/uint"}
          }
        }
      }
    },
    "slotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "median_cow_pss_bytes", "median_non_cow_pss_bytes", "median_pss_saved_bytes", "median_pss_reduction_ppm", "median_non_cow_to_cow_ready_time_ppm"],
      "properties": {
        "slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "median_cow_pss_bytes": {"$ref": "#/$defs/positive"},
        "median_non_cow_pss_bytes": {"$ref": "#/$defs/positive"},
        "median_pss_saved_bytes": {"type": "integer"},
        "median_pss_reduction_ppm": {"type": "integer"},
        "median_non_cow_to_cow_ready_time_ppm": {"$ref": "#/$defs/uint"}
      }
    }
  }
}
