      "file": "researcher.py",
      "source": "from pathlib import Path\ndependencies = [\"wazero pinned\", \"CPython/WASI artifact recorded\", \"SQLite schema unchanged\"]\nreport = \"# Dependency review\\n\\n\" + \"\\n\".join(f\"- {item}\" for item in dependencies)\nPath(\"/workspace/dependency-review.md\").write_text(report)\nresult = report"
    },
    {
      "id": "reviewer",
      "role": "release-reviewer",
      "file": "reviewer.py",
      "source": "from pathlib import Path\nchecks = [\"128 tests passed\", \"migration notes present\", \"rollback documented\"]\nchecklist = \"# Release checklist\\n\\n\" + \"\\n\".join(f\"- [x] {item}\" for item in checks)\nPath(\"/workspace/release-checklist.md\").write_text(checklist)\nresult = checklist"
    }
  ],
