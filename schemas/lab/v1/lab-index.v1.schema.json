      "additionalProperties": false,
      "properties": {
        "cursor": {
          "pattern": "^(?:[A-Za-z0-9_-]{1,128})?$",
          "type": "string"
        },
        "next_cursor": {
          "pattern": "^(?:[A-Za-z0-9_-]{1,128})?$",
          "type": "string"
        },
        "returned": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "cursor",
        "next_cursor",
        "returned",
        "total",
        "truncated"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "pysolate.lab-index.v1"
    },
    "source_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
