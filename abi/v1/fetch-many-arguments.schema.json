{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/fetch-many-arguments.schema.json",
  "title": "Agent Python Runtime fetch_many arguments v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requests"],
  "properties": {
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "target", "path"],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "path": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
