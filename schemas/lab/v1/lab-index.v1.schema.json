            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "rel",
            "kind",
            "sha256"
          ],
          "type": "object"
        }
      ],
      "type": "array"
