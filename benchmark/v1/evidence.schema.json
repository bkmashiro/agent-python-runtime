{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bkmashiro/agent-python-runtime/benchmark/v1/evidence.schema.json",
  "title": "Agent Python Runtime benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "artifact", "host_source", "backend", "environment", "fixture", "compile_once", "workloads", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_class": {"enum": ["production-safe", "full", "profile-candidate", "preinitialization-spike"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes", "source_commit", "target", "execution_model"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_profile": {"enum": ["base", "numpy-core"]},
        "target": {"const": "wasm32-wasip1"},
        "execution_model": {"const": "reactor"}
      }
    },
    "host_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "modified": {"const": false}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reset_mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reset_mode": {"const": "fresh-instance"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "go_version"],
      "properties": {
        "goos": {"type": "string", "minLength": 1},
        "goarch": {"type": "string", "minLength": 1},
        "go_version": {"type": "string", "minLength": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "capability_operations", "provider_delay_ns_per_operation"],
      "properties": {
        "workload": {"enum": ["basic", "numpy-import"]},
        "samples": {"type": "integer", "minimum": 3, "maximum": 20},
        "capability_operations": {"type": "integer", "minimum": 1, "maximum": 20},
        "provider_delay_ns_per_operation": {"const": 2000000}
      }
    },
    "compile_once": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantiate_host_ns", "compile_ns"],
      "properties": {
        "instantiate_host_ns": {"type": "integer", "minimum": 1},
        "compile_ns": {"type": "integer", "minimum": 1}
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execute", "capability"],
      "properties": {
        "execute": {"type": "array", "minItems": 3, "maxItems": 20, "items": {"$ref": "#/$defs/executeSample"}},
        "capability": {"type": "array", "minItems": 3, "maxItems": 20, "items": {"$ref": "#/$defs/capabilitySample"}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "profile-candidate"}}},
      "then": {"properties": {"artifact": {"required": ["artifact_profile"], "properties": {"artifact_profile": {"const": "numpy-core"}}}}}
    },
    {
      "if": {"properties": {"evidence_class": {"const": "preinitialization-spike"}}},
      "then": {"properties": {"artifact": {"required": ["artifact_profile"], "properties": {"artifact_profile": {"const": "base"}}}}}
    },
    {
      "if": {"properties": {"evidence_class": {"enum": ["production-safe", "full"]}}},
      "then": {"properties": {"artifact": {"properties": {"artifact_profile": {"const": "base"}}}}}
    }
  ],
  "$defs": {
    "executeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantiate_guest_ns", "_initialize_ns", "runtime_init_ns", "prepare_ns", "execute_ns", "capability_ns", "run_total_ns", "request_bytes", "result_bytes"],
      "properties": {
        "instantiate_guest_ns": {"type": "integer", "minimum": 1},
        "_initialize_ns": {"type": "integer", "minimum": 1},
        "runtime_init_ns": {"type": "integer", "minimum": 1},
        "attach_host_calls_ns": {"type": "integer", "minimum": 1},
        "prepare_ns": {"type": "integer", "minimum": 1},
        "execute_ns": {"type": "integer", "minimum": 1},
        "capability_ns": {"const": 0},
        "run_total_ns": {"type": "integer", "minimum": 1},
        "request_bytes": {"type": "integer", "minimum": 1},
        "result_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "capabilitySample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantiate_guest_ns", "_initialize_ns", "runtime_init_ns", "prepare_ns", "execute_ns", "capability_ns", "run_total_ns", "request_bytes", "result_bytes"],
      "properties": {
        "instantiate_guest_ns": {"type": "integer", "minimum": 1},
        "_initialize_ns": {"type": "integer", "minimum": 1},
        "runtime_init_ns": {"type": "integer", "minimum": 1},
        "attach_host_calls_ns": {"type": "integer", "minimum": 1},
        "prepare_ns": {"type": "integer", "minimum": 1},
        "execute_ns": {"type": "integer", "minimum": 1},
        "capability_ns": {"type": "integer", "minimum": 1},
        "run_total_ns": {"type": "integer", "minimum": 1},
        "request_bytes": {"type": "integer", "minimum": 1},
        "result_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
