{
  "schema_version": 1,
  "profile": "agent-core",
  "target": "wasm32-wasip1",
  "runtime": {
    "cpython": "3.14.0",
    "numpy": "1.26.0b1",
    "pyyaml": "6.0.3"
  },
  "build_inputs": [
    "tools/build-inputs.lock.json",
    "guest/build/profiles/numpy-core.lock.json"
  ],
  "policy": {
    "runtime_package_installation": false,
    "guest_network": false,
    "guest_subprocess": false,
    "ambient_host_filesystem": false,
    "host_tools": true,
    "private_workspace": true
  },
  "qualification": [
    {"name": "json", "operation": "json_roundtrip"},
    {"name": "csv", "operation": "csv_roundtrip"},
    {"name": "text", "operation": "text_processing"},
    {"name": "regex", "operation": "regex_capture"},
    {"name": "datetime", "operation": "datetime_iso"},
    {"name": "hashlib", "operation": "sha256"},
    {"name": "html", "operation": "html_parse"},
    {"name": "xml", "operation": "xml_parse"},
    {"name": "yaml", "operation": "yaml_safe_roundtrip"},
    {"name": "repository-code", "operation": "repository_code_tools"},
    {"name": "config", "operation": "config_formats"},
    {"name": "data-utilities", "operation": "data_utilities"},
    {"name": "numpy", "operation": "numpy_core"},
    {"name": "workspace", "operation": "workspace_edit_acceptance"},
    {"name": "common-usecases", "operation": "common_usecases_acceptance"}
  ]
}
