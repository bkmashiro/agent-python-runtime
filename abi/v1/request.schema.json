{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/request.schema.json",
  "title": "Agent Python Runtime RunRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "code", "inputs"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "code": {
      "type": "string",
      "maxLength": 1048576
    },
    "inputs": {},
    "output_schema": {
      "oneOf": [
        {"type": "object"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "imports"],
      "properties": {
        "profile": {
          "enum": ["base", "numpy-core"]
        },
        "imports": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "browser_runtime",
          "daemon",
          "dynamic_package_install",
          "native_extension",
          "native_threads",
          "posix",
          "shell",
          "subprocess"
        ]
      }
    }
  }
}
