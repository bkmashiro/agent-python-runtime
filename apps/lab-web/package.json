{
  "name": "pysolate-lab-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Latest-only Pysolate mechanism evidence workspace.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data:unified": "cd ../.. && go run ./research/labview/cmd/project-unified --input docs/evidence/unified-day-trip-campaign-v2.json --output apps/lab-web/public/lab-data/unified-campaign.json --identity-output apps/lab-web/src/unifiedIdentity.ts",
    "data:provider-summary": "node scripts/project-provider-summary.mjs $PRIVATE_PROVIDER_DEBUG public/lab-data/provider-summary.json src/providerSummaryIdentity.ts",
    "data:latest": "cd ../.. && go run ./research/labview/cmd/project-latest --source-prefix-contract docs/evidence/source-prefix-day-trip-contract-v2.json --source-prefix-evidence docs/evidence/source-prefix-day-trip-evidence-v2.json --campaign-manifest docs/evidence/authority-transparent-campaign-manifest-v1.json --campaign-projection docs/evidence/authority-transparent-campaign-v1.json --semantic-predispatch docs/evidence/semantic-predispatch-day-trip-v1.json --semantic-reuse docs/evidence/semantic-reuse-observation.json --cow-growable docs/evidence/linux-cow-growable-outcome.json --cold-io docs/evidence/linux-cold-io-continuation-observation.json --composable docs/evidence/spark-composable-direct-report.json --output apps/lab-web/public/lab-data/latest.json --identity-output apps/lab-web/src/latestIdentity.ts",
    "data:task": "cd ../.. && go run ./research/labview/cmd/project-task --corpus research/composableacceptance/testdata/lab-release-readiness-corpus.json --report docs/evidence/lab-release-readiness-direct-report.json --capture docs/evidence/lab-release-readiness-body-capture.json --output apps/lab-web/public/lab-data/task.json --identity-output apps/lab-web/src/taskIdentity.ts",
    "figure:paper": "cd ../.. && go run ./research/labview/cmd/render-paper-figure --input apps/lab-web/public/lab-data/latest.json --output docs/figures/pysolate-runtime-optimization-examples-v1.svg",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
