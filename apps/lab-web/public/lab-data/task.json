  "id": "dev-workspace-summary",
  "title": "Summarize a development workspace",
  "task": "Summarize a public development workspace and record the selected analysis branch.",
  "status": "passed",
  "expected_artifact": "2 files|selected=1|status=ready",
  "sources": [
    {
      "id": "orchestrator",
      "role": "orchestrator",
      "file": "orchestrator.py",
      "source": "files = [\"/workspace/input-a.txt\", \"/workspace/input-b.txt\"]\nselected_child = 1\nresult = f\"{len(files)} files|selected={selected_child}|status=ready\""
    },
    {
      "id": "researcher",
      "role": "researcher",
      "file": "researcher.py",
      "source": "from pathlib import Path\nanalysis = \"workspace-summary: evidence collected\"\nPath(\"/workspace/researcher.txt\").write_text(analysis)\nresult = analysis"
    },
    {
      "id": "reviewer",
      "role": "reviewer",
      "file": "reviewer.py",
      "source": "from pathlib import Path\nreview = \"workspace-summary: review approved\"\nPath(\"/workspace/reviewer.txt\").write_text(review)\nresult = review"
    }
  ],
