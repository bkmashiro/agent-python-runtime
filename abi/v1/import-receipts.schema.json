{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/import-receipts.schema.json",
  "title": "Host-bound CPython import receipts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collector", "plan_sha256", "events", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "collector": {"const": "cpython-pre-cache-import-gate-v1"},
    "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "events": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "module_name", "decision"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0, "maximum": 1023},
          "module_name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
          "decision": {"enum": ["admitted", "denied"]}
        }
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
