{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/response.schema.json",
  "title": "Agent Python Runtime RunResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "result", "receipts", "metrics", "error"],
  "properties": {
    "status": {"enum": ["ok", "error"]},
    "result": {},
    "receipts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "run_id", "capability", "operation_index", "outcome"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "capability": {"type": "string", "minLength": 1, "maxLength": 128},
          "operation_index": {"type": "integer", "minimum": 0},
          "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["ok", "denied", "error", "timeout"]}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guest_time_ms": {"type": "number", "minimum": 0},
        "capability_calls": {"type": "integer", "minimum": 0},
        "result_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 128},
            "message": {"type": "string", "maxLength": 4096},
            "error_type": {"type": "string", "maxLength": 256},
            "traceback": {"type": "string", "maxLength": 16384}
          }
        }
      ]
    }
  }
}
