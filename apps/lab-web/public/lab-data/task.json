      "source": "release = {\"package\": \"pysolate-sdk\", \"version\": \"0.8.0\", \"tests_passed\": 128, \"tests_failed\": 0, \"migrations\": [\"authority-v2\", \"workspace-receipts\"]}\nstatus = \"ready\" if release[\"tests_failed\"] == 0 else \"blocked\"\nresult = f\"{release['package']}@{release['version']}|tests={release['tests_passed']}/128|migrations={len(release['migrations'])}|status={status}\""
