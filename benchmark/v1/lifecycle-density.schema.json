{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bkmashiro/agent-python-runtime/benchmark/v1/lifecycle-density.schema.json",
  "$comment": "This schema is the structural gate. Consumers MUST also run runtime/evidence.ValidateLifecycleDensityJSON for cross-sample ordering, histogram-shape, derived-value, and other semantic checks.",
  "title": "Agent Python Runtime lifecycle density evidence v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "artifact",
    "host_source",
    "backend",
    "environment",
    "strategy",
    "plan",
    "samples",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "evidence_class": {"const": "lifecycle-density"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "host_source": {"$ref": "#/$defs/hostSource"},
    "backend": {"$ref": "#/$defs/backend"},
    "environment": {"$ref": "#/$defs/environment"},
    "strategy": {"$ref": "#/$defs/strategy"},
    "warmup": {"$ref": "#/$defs/preparedWarmup"},
    "plan": {"$ref": "#/$defs/plan"},
    "samples": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7000,
      "items": {"$ref": "#/$defs/sample"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"not": {"required": ["warmup"]}},
      "else": {
        "required": ["warmup"],
        "properties": {
          "artifact": {"properties": {"artifact_profile": {"const": "numpy-core"}}},
          "strategy": {"not": {"properties": {"active": {"const": "fresh-instance"}}}},
          "plan": {
            "properties": {
              "workload": {"const": "numpy-ready-idle"},
              "slot_counts": {
                "prefixItems": [
                  {"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}, {"const": 64}
                ],
                "items": false,
                "minItems": 7,
                "maxItems": 7
              }
            }
          },
          "samples": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/sample"},
                {"properties": {"phases": {"required": ["warmup_ns"]}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes", "source_commit", "artifact_profile", "target", "execution_model"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_profile": {"enum": ["base", "numpy-core"]},
        "target": {"const": "wasm32-wasip1"},
        "execution_model": {"const": "reactor"}
      }
    },
    "hostSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "modified": {"const": false}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "reset_mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "reset_mode": {"const": "fresh-instance"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "go_version", "kernel_release", "page_size_bytes", "cgroup_version"],
      "properties": {
        "goos": {"type": "string", "minLength": 1},
        "goarch": {"type": "string", "minLength": 1},
        "go_version": {"type": "string", "minLength": 1},
        "kernel_release": {"type": "string", "minLength": 1},
        "page_size_bytes": {"type": "integer", "minimum": 1},
        "cgroup_version": {"enum": ["v2", "none"]}
      }
    },
    "strategy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "active", "fallback"],
          "properties": {
            "requested": {"const": "fresh-instance"},
            "active": {"const": "fresh-instance"},
            "fallback": {"const": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "active", "fallback"],
          "properties": {
            "requested": {"const": "single-use-preinitialized"},
            "active": {"const": "single-use-preinitialized"},
            "fallback": {"const": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "active", "fallback"],
          "properties": {
            "requested": {"const": "single-use-preinitialized-shared-cache"},
            "active": {"const": "single-use-preinitialized-shared-cache"},
            "fallback": {"const": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "active", "fallback"],
          "properties": {
            "requested": {"const": "cow-ready-single-use"},
            "active": {"const": "cow-ready-single-use"},
            "fallback": {"const": false}
          }
        }
      ]
    },
    "preparedWarmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "generation_sha256"],
      "properties": {
        "profile": {"const": "numpy-ready-v1"},
        "generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "slot_counts", "repeats_per_slot", "fresh_process_per_sample", "max_process_rss_bytes", "child_timeout_ns"],
      "properties": {
        "workload": {"enum": ["idle-ready", "execute", "capability", "numpy-ready-idle"]},
        "slot_counts": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}, {"const": 16}],
              "items": false,
              "minItems": 5,
              "maxItems": 5
            },
            {
              "type": "array",
              "prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}],
              "items": false,
              "minItems": 6,
              "maxItems": 6
            },
            {
              "type": "array",
              "prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}, {"const": 64}],
              "items": false,
              "minItems": 7,
              "maxItems": 7
            }
          ]
        },
        "repeats_per_slot": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fresh_process_per_sample": {"const": true},
        "max_process_rss_bytes": {"type": "integer", "minimum": 1, "maximum": 1125899906842624},
        "child_timeout_ns": {"type": "integer", "minimum": 1, "maximum": 86400000000000}
      }
    },
    "rawMetric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {"const": "measured"},
            "value": {"type": "integer", "minimum": 0}
          }
        },
        {"$ref": "#/$defs/unavailableMetric"}
      ]
    },
    "timestampMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"const": "timestamp_observed"},
        "value": {"type": "integer", "minimum": 0}
      }
    },
    "modelMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "model"],
      "properties": {
        "status": {"const": "model_estimated"},
        "value": {"type": "integer", "minimum": 0},
        "model": {"enum": ["fixed_plus_per_slot", "segmented_linear"]}
      }
    },
    "summaryMetric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {"const": "measured"},
            "value": {"type": "integer", "minimum": 0}
          }
        },
        {"$ref": "#/$defs/unavailableMetric"}
      ]
    },
    "unavailableMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": {"enum": ["unsupported", "skipped"]},
        "reason_code": {
          "enum": [
            "source_unavailable",
            "permission_denied",
            "not_applicable",
            "platform_unsupported",
            "collection_error",
            "safety_guard",
            "workload_not_run",
            "nonisolated_scope",
            "isolation_unproven"
          ]
        }
      }
    },
    "nonisolatedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": {"const": "skipped"},
        "reason_code": {"const": "nonisolated_scope"}
      }
    },
    "isolationUnprovenMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": {"const": "skipped"},
        "reason_code": {"const": "isolation_unproven"}
      }
    },
    "notApplicableMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": {"const": "unsupported"},
        "reason_code": {"const": "not_applicable"}
      }
    },
    "histogram": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "upper_bounds_ns", "counts"],
          "properties": {
            "status": {"const": "measured"},
            "upper_bounds_ns": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
            "counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
          }
        },
        {"$ref": "#/$defs/unavailableMetric"}
      ]
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_capacity", "initializing", "ready", "leased", "unhealthy", "retiring", "accounted_slots"],
      "properties": {
        "target_capacity": {"type": "integer", "minimum": 0, "maximum": 64},
        "initializing": {"type": "integer", "minimum": 0, "maximum": 64},
        "ready": {"type": "integer", "minimum": 0, "maximum": 64},
        "leased": {"type": "integer", "minimum": 0, "maximum": 64},
        "unhealthy": {"type": "integer", "minimum": 0, "maximum": 64},
        "retiring": {"type": "integer", "minimum": 0, "maximum": 64},
        "accounted_slots": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ns", "instantiate_ns", "initialize_ns", "runtime_init_ns", "prepare_ns", "execute_ns", "capability_ns", "total_ns"],
      "properties": {
        "queue_ns": {"$ref": "#/$defs/rawMetric"},
        "compile_ns": {"$ref": "#/$defs/rawMetric"},
        "instantiate_ns": {"$ref": "#/$defs/rawMetric"},
        "initialize_ns": {"$ref": "#/$defs/rawMetric"},
        "runtime_init_ns": {"$ref": "#/$defs/rawMetric"},
        "prepare_ns": {"$ref": "#/$defs/rawMetric"},
        "warmup_ns": {"$ref": "#/$defs/rawMetric"},
        "execute_ns": {"$ref": "#/$defs/rawMetric"},
        "capability_ns": {"$ref": "#/$defs/rawMetric"},
        "total_ns": {"$ref": "#/$defs/rawMetric"}
      }
    },
    "goRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heap_live_bytes", "heap_goal_bytes", "gc_cycles_total", "gc_pause_total_ns", "goroutines", "scheduler_latency"],
      "properties": {
        "heap_live_bytes": {"$ref": "#/$defs/rawMetric"},
        "heap_goal_bytes": {"$ref": "#/$defs/rawMetric"},
        "gc_cycles_total": {"$ref": "#/$defs/rawMetric"},
        "gc_pause_total_ns": {"$ref": "#/$defs/rawMetric"},
        "goroutines": {"$ref": "#/$defs/rawMetric"},
        "scheduler_latency": {"$ref": "#/$defs/histogram"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rss_bytes", "virtual_bytes", "pss_bytes", "private_clean_bytes", "private_dirty_bytes", "swap_bytes", "minor_faults", "major_faults", "fd_count", "vma_count"],
      "properties": {
        "rss_bytes": {"$ref": "#/$defs/rawMetric"},
        "virtual_bytes": {"$ref": "#/$defs/rawMetric"},
        "pss_bytes": {"$ref": "#/$defs/rawMetric"},
        "private_clean_bytes": {"$ref": "#/$defs/rawMetric"},
        "private_dirty_bytes": {"$ref": "#/$defs/rawMetric"},
        "swap_bytes": {"$ref": "#/$defs/rawMetric"},
        "minor_faults": {"$ref": "#/$defs/rawMetric"},
        "major_faults": {"$ref": "#/$defs/rawMetric"},
        "fd_count": {"$ref": "#/$defs/rawMetric"},
        "vma_count": {"$ref": "#/$defs/rawMetric"},
        "page_table_bytes": {"$ref": "#/$defs/rawMetric"}
      }
    },
    "mappingMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mapping_count", "virtual_bytes", "rss_bytes", "pss_bytes", "shared_clean_bytes", "shared_dirty_bytes", "private_clean_bytes", "private_dirty_bytes", "referenced_bytes", "anonymous_bytes"],
      "properties": {
        "name": {"const": "memfd:apyrun-cow-image"},
        "mapping_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "virtual_bytes": {"$ref": "#/$defs/rawMetric"},
        "rss_bytes": {"$ref": "#/$defs/rawMetric"},
        "pss_bytes": {"$ref": "#/$defs/rawMetric"},
        "shared_clean_bytes": {"$ref": "#/$defs/rawMetric"},
        "shared_dirty_bytes": {"$ref": "#/$defs/rawMetric"},
        "private_clean_bytes": {"$ref": "#/$defs/rawMetric"},
        "private_dirty_bytes": {"$ref": "#/$defs/rawMetric"},
        "referenced_bytes": {"$ref": "#/$defs/rawMetric"},
        "anonymous_bytes": {"$ref": "#/$defs/rawMetric"}
      }
    },
    "cgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "memory_current_bytes", "memory_peak_bytes", "memory_swap_current_bytes", "memory_events_high_total", "memory_events_oom_total", "memory_events_oom_kill_total", "pressure_some_total_us", "pressure_full_total_us"],
      "properties": {
        "version": {"enum": ["v2", "none"]},
        "scope": {"enum": ["shared", "unverified"]},
        "membership_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "memory_current_bytes": {"$ref": "#/$defs/rawMetric"},
        "memory_peak_bytes": {"$ref": "#/$defs/rawMetric"},
        "memory_swap_current_bytes": {"$ref": "#/$defs/rawMetric"},
        "memory_events_high_total": {"$ref": "#/$defs/rawMetric"},
        "memory_events_oom_total": {"$ref": "#/$defs/rawMetric"},
        "memory_events_oom_kill_total": {"$ref": "#/$defs/rawMetric"},
        "pressure_some_total_us": {"$ref": "#/$defs/rawMetric"},
        "pressure_full_total_us": {"$ref": "#/$defs/rawMetric"}
      },
      "allOf": [
        {
          "if": {"properties": {"version": {"const": "v2"}}},
          "then": {"required": ["membership_sha256"]}
        },
        {
          "if": {"properties": {"version": {"const": "none"}}},
          "then": {
            "properties": {
              "scope": {"const": "unverified"},
              "memory_current_bytes": {"$ref": "#/$defs/notApplicableMetric"},
              "memory_peak_bytes": {"$ref": "#/$defs/notApplicableMetric"},
              "memory_swap_current_bytes": {"$ref": "#/$defs/notApplicableMetric"},
              "memory_events_high_total": {"$ref": "#/$defs/notApplicableMetric"},
              "memory_events_oom_total": {"$ref": "#/$defs/notApplicableMetric"},
              "memory_events_oom_kill_total": {"$ref": "#/$defs/notApplicableMetric"},
              "pressure_some_total_us": {"$ref": "#/$defs/notApplicableMetric"},
              "pressure_full_total_us": {"$ref": "#/$defs/notApplicableMetric"}
            },
            "not": {"required": ["membership_sha256"]}
          }
        },
        {
          "if": {"properties": {"scope": {"const": "shared"}}},
          "then": {
            "properties": {
              "memory_current_bytes": {"$ref": "#/$defs/nonisolatedMetric"},
              "memory_peak_bytes": {"$ref": "#/$defs/nonisolatedMetric"},
              "memory_swap_current_bytes": {"$ref": "#/$defs/nonisolatedMetric"},
              "memory_events_high_total": {"$ref": "#/$defs/nonisolatedMetric"},
              "memory_events_oom_total": {"$ref": "#/$defs/nonisolatedMetric"},
              "memory_events_oom_kill_total": {"$ref": "#/$defs/nonisolatedMetric"},
              "pressure_some_total_us": {"$ref": "#/$defs/nonisolatedMetric"},
              "pressure_full_total_us": {"$ref": "#/$defs/nonisolatedMetric"}
            }
          }
        },
        {
          "if": {"properties": {"version": {"const": "v2"}, "scope": {"const": "unverified"}}},
          "then": {
            "properties": {
              "memory_current_bytes": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "memory_peak_bytes": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "memory_swap_current_bytes": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "memory_events_high_total": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "memory_events_oom_total": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "memory_events_oom_kill_total": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "pressure_some_total_us": {"$ref": "#/$defs/isolationUnprovenMetric"},
              "pressure_full_total_us": {"$ref": "#/$defs/isolationUnprovenMetric"}
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_index", "repeat_index", "requested_slots", "runtime_shards", "active_concurrency", "process_instance_sha256", "observed_at_unix_ns", "pool", "phases", "go_runtime", "process", "cgroup"],
      "properties": {
        "sample_index": {"type": "integer", "minimum": 0},
        "repeat_index": {"type": "integer", "minimum": 0, "maximum": 999},
        "requested_slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "runtime_shards": {"type": "integer", "minimum": 1, "maximum": 64},
        "active_concurrency": {"type": "integer", "minimum": 0, "maximum": 64},
        "process_instance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at_unix_ns": {"$ref": "#/$defs/timestampMetric"},
        "pool": {"$ref": "#/$defs/pool"},
        "phases": {"$ref": "#/$defs/phases"},
        "go_runtime": {"$ref": "#/$defs/goRuntime"},
        "process": {"$ref": "#/$defs/process"},
        "cow_mappings": {"$ref": "#/$defs/mappingMetrics"},
        "cgroup": {"$ref": "#/$defs/cgroup"}
      },
      "allOf": [
        {"if": {"properties": {"requested_slots": {"const": 1}}}, "then": {"properties": {"runtime_shards": {"maximum": 1}, "active_concurrency": {"maximum": 1}}}},
        {"if": {"properties": {"requested_slots": {"const": 2}}}, "then": {"properties": {"runtime_shards": {"maximum": 2}, "active_concurrency": {"maximum": 2}}}},
        {"if": {"properties": {"requested_slots": {"const": 4}}}, "then": {"properties": {"runtime_shards": {"maximum": 4}, "active_concurrency": {"maximum": 4}}}},
        {"if": {"properties": {"requested_slots": {"const": 8}}}, "then": {"properties": {"runtime_shards": {"maximum": 8}, "active_concurrency": {"maximum": 8}}}},
        {"if": {"properties": {"requested_slots": {"const": 16}}}, "then": {"properties": {"runtime_shards": {"maximum": 16}, "active_concurrency": {"maximum": 16}}}},
        {"if": {"properties": {"requested_slots": {"const": 32}}}, "then": {"properties": {"runtime_shards": {"maximum": 32}, "active_concurrency": {"maximum": 32}}}},
        {"if": {"properties": {"requested_slots": {"const": 64}}}, "then": {"properties": {"runtime_shards": {"maximum": 64}, "active_concurrency": {"maximum": 64}}}}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "peak_process_rss_bytes", "peak_cgroup_memory_current_bytes", "peak_go_heap_live_bytes"],
      "dependentRequired": {
        "estimated_fixed_bytes": ["estimated_per_slot_bytes"],
        "estimated_per_slot_bytes": ["estimated_fixed_bytes"]
      },
      "properties": {
        "sample_count": {"type": "integer", "minimum": 5, "maximum": 7000},
        "peak_process_rss_bytes": {"$ref": "#/$defs/summaryMetric"},
        "peak_cgroup_memory_current_bytes": {"$ref": "#/$defs/summaryMetric"},
        "peak_go_heap_live_bytes": {"$ref": "#/$defs/summaryMetric"},
        "estimated_fixed_bytes": {"$ref": "#/$defs/modelMetric"},
        "estimated_per_slot_bytes": {"$ref": "#/$defs/modelMetric"}
      }
    }
  }
}
