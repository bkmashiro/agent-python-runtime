{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/session/v1/unsupported-reason.schema.json",
  "title": "Agent Python Runtime unsupported session lifecycle reason v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "code"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["capture", "resume"]},
    "code": {
      "enum": [
        "not_quiescent",
        "mutable_state_unsupported",
        "external_resource_active",
        "artifact_mismatch",
        "base_mismatch",
        "runtime_mismatch",
        "architecture_mismatch",
        "capsule_invalid",
        "lease_conflict"
      ]
    },
    "state_class": {
      "enum": [
        "linear_memory",
        "mutable_global",
        "table",
        "wasi_resource",
        "host_state",
        "external_handle"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "capture"}}},
      "then": {
        "properties": {
          "code": {
            "enum": [
              "not_quiescent",
              "mutable_state_unsupported",
              "external_resource_active",
              "lease_conflict"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "resume"}}},
      "then": {
        "properties": {
          "code": {
            "enum": [
              "mutable_state_unsupported",
              "artifact_mismatch",
              "base_mismatch",
              "runtime_mismatch",
              "architecture_mismatch",
              "capsule_invalid",
              "lease_conflict"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"code": {"const": "mutable_state_unsupported"}}},
      "then": {"required": ["state_class"]},
      "else": {"not": {"required": ["state_class"]}}
    }
  ]
}
