{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/source-validation-evidence.schema.json",
  "title": "Exact Guest source validation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validator", "status", "source_sha256", "profile", "declared_import_roots", "ast_import_roots", "bytecode_checked", "baseline_modules", "entry_closure_modules", "sealed_modules"],
  "properties": {
    "schema_version": {"const": 1},
    "validator": {"const": "exact-guest-static-imports-v1"},
    "status": {"const": "ready"},
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"enum": ["base", "numpy-core"]},
    "declared_import_roots": {"$ref": "#/$defs/importRoots"},
    "ast_import_roots": {"$ref": "#/$defs/importRoots"},
    "bytecode_checked": {"const": true},
    "baseline_modules": {"$ref": "#/$defs/modules"},
    "entry_closure_modules": {"$ref": "#/$defs/modules"},
    "sealed_modules": {"$ref": "#/$defs/modules"}
  },
  "$defs": {
    "importRoots": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
    "modules": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"}}
  }
}
