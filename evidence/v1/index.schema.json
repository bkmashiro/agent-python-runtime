{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bkmashiro/agent-python-runtime/evidence/v1/index.schema.json",
  "title": "Agent Python Runtime CI Evidence Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "repository", "workflow", "artifact", "manifest", "sbom", "notices", "tests", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_class": {"const": "private-ci"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run_id", "run_url"],
      "properties": {
        "name": {"const": "Guest artifact"},
        "run_id": {"type": "string", "pattern": "^[0-9]+$"},
        "run_url": {"type": "string", "format": "uri", "pattern": "/actions/runs/[0-9]+$"}
      }
    },
    "artifact": {"$ref": "#/$defs/fileIdentity"},
    "manifest": {"$ref": "#/$defs/fileIdentity"},
    "sbom": {"$ref": "#/$defs/fileIdentity"},
    "notices": {"$ref": "#/$defs/fileIdentity"},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_lock", "producer_contracts", "artifact_binding", "spdx_schema", "downloaded_bundle", "guest_e2e", "fresh_benchmark", "prepared_benchmark"],
      "properties": {
        "source_lock": {"const": "passed"},
        "producer_contracts": {"const": "passed"},
        "artifact_binding": {"const": "passed"},
        "spdx_schema": {"const": "passed"},
        "downloaded_bundle": {"const": "passed"},
        "guest_e2e": {"const": "passed"},
        "fresh_benchmark": {"const": "recorded"},
        "prepared_benchmark": {"const": "recorded"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1},
      "contains": {"type": "string", "pattern": "not established"}
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
