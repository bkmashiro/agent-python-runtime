{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bkmashiro.github.io/agent-python-runtime/benchmark/v1/phase7-paired-density.schema.json",
  "title": "Phase 7 paired NumPy density summary v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "artifact", "warmup", "host_source", "backend", "environment", "plan", "source_evidence", "pairs", "summary_by_slots", "coverage_by_slots", "boundary_outcomes"],
  "properties": {
    "schema_version": {"const": 2},
    "evidence_class": {"const": "phase7-paired-density"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "generation_sha256"],
      "properties": {
        "profile": {"const": "numpy-ready-v1"},
        "generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "host_source": {"$ref": "#/$defs/hostSource"},
    "backend": {"$ref": "#/$defs/backend"},
    "environment": {"$ref": "#/$defs/environment"},
    "plan": {"$ref": "#/$defs/plan"},
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cow_sha256", "non_cow_sha256"],
      "properties": {
        "cow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "non_cow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 140,
      "items": {"$ref": "#/$defs/pair"}
    },
    "summary_by_slots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/slotSummary"}
    },
    "coverage_by_slots": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "boundary_outcomes": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/boundaryOutcome"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes", "source_commit", "artifact_profile", "target", "execution_model"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_profile": {"const": "numpy-core"},
        "target": {"const": "wasm32-wasip1"},
        "execution_model": {"const": "reactor"}
      }
    },
    "hostSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "modified": {"const": false}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "reset_mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "reset_mode": {"const": "fresh-instance"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goos", "goarch", "go_version", "kernel_release", "page_size_bytes", "cgroup_version"],
      "properties": {
        "goos": {"const": "linux"},
        "goarch": {"const": "amd64"},
        "go_version": {"type": "string", "minLength": 1},
        "kernel_release": {"type": "string", "minLength": 1},
        "page_size_bytes": {"type": "integer", "minimum": 1},
        "cgroup_version": {"enum": ["v2", "none"]}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "slot_counts", "repeats_per_slot", "fresh_process_per_sample", "max_process_rss_bytes", "child_timeout_ns"],
      "properties": {
        "workload": {"const": "numpy-ready-idle"},
        "slot_counts": {
          "type": "array",
          "prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}, {"const": 16}, {"const": 32}, {"const": 64}],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        "repeats_per_slot": {"enum": [1, 3]},
        "fresh_process_per_sample": {"const": true},
        "max_process_rss_bytes": {"const": 8589934592},
        "child_timeout_ns": {"const": 240000000000}
      }
    },
    "uint": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_shards", "ready_total_ns", "warmup_ns", "rss_bytes", "pss_bytes", "private_dirty_bytes"],
      "properties": {
        "runtime_shards": {"$ref": "#/$defs/positive"},
        "ready_total_ns": {"$ref": "#/$defs/positive"},
        "warmup_ns": {"$ref": "#/$defs/uint"},
        "rss_bytes": {"$ref": "#/$defs/uint"},
        "pss_bytes": {"$ref": "#/$defs/positive"},
        "private_dirty_bytes": {"$ref": "#/$defs/uint"},
        "cow_mapping_pss_bytes": {"$ref": "#/$defs/uint"}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "repeat", "cow", "non_cow", "derived"],
      "properties": {
        "slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 20},
        "cow": {"allOf": [{"$ref": "#/$defs/arm"}, {"required": ["cow_mapping_pss_bytes"]}]},
        "non_cow": {"$ref": "#/$defs/arm"},
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pss_saved_bytes", "pss_reduction_ppm", "non_cow_to_cow_ready_time_ppm"],
          "properties": {
            "pss_saved_bytes": {"type": "integer"},
            "pss_reduction_ppm": {"type": "integer"},
            "non_cow_to_cow_ready_time_ppm": {"$ref": "#/$defs/uint"}
          }
        }
      }
    },
    "slotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "median_cow_pss_bytes", "median_non_cow_pss_bytes", "median_pss_saved_bytes", "median_pss_reduction_ppm", "median_non_cow_to_cow_ready_time_ppm"],
      "properties": {
        "slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "median_cow_pss_bytes": {"$ref": "#/$defs/positive"},
        "median_non_cow_pss_bytes": {"$ref": "#/$defs/positive"},
        "median_pss_saved_bytes": {"type": "integer"},
        "median_pss_reduction_ppm": {"type": "integer"},
        "median_non_cow_to_cow_ready_time_ppm": {"$ref": "#/$defs/uint"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "cow_measured", "cow_rss_guard", "non_cow_measured", "non_cow_rss_guard"],
      "properties": {
        "slots": {"enum": [1, 2, 4, 8, 16, 32, 64]},
        "cow_measured": {"$ref": "#/$defs/uint"},
        "cow_rss_guard": {"const": 0},
        "non_cow_measured": {"$ref": "#/$defs/uint"},
        "non_cow_rss_guard": {"$ref": "#/$defs/uint"}
      }
    },
    "boundaryOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "repeat", "arm", "status", "max_observed_rss_bytes", "guard_rss_bytes", "process_instance_sha256"],
      "properties": {
        "slots": {"const": 64},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 20},
        "arm": {"const": "non_cow"},
        "status": {"const": "rss_guard"},
        "max_observed_rss_bytes": {"$ref": "#/$defs/positive"},
        "guard_rss_bytes": {"const": 8589934592},
        "process_instance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
