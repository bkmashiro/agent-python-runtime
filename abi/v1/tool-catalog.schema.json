{
  "$id": "https://agent-runtime.dev/abi/v1/tool-catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "discovered_at": {
      "format": "date-time",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "tools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2048,
            "type": "string"
          },
          "effect_class": {
            "enum": [
              "read_only",
              "reversible",
              "compensatable",
              "irreversible"
            ]
          },
          "grant_version": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "max_calls": {
            "maximum": 1024,
            "minimum": 1,
            "type": "integer"
          },
          "handler_version": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "input_schema": {
            "allOf": [
              {"type": "object", "maxProperties": 128},
              {"$ref": "https://json-schema.org/draft/2020-12/schema"}
            ]
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "output_schema": {
            "allOf": [
              {"type": "object", "maxProperties": 128},
              {"$ref": "https://json-schema.org/draft/2020-12/schema"}
            ]
          },
          "policy": {
            "enum": [
              "DENY",
              "AUTO_COMMIT",
              "AGENT_COMMIT_REQUIRED",
              "USER_APPROVAL_REQUIRED"
            ]
          },
          "projection": {
            "enum": [
              "exact",
              "lossy",
              "unsupported"
            ]
          },
          "server_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "tool_id": {
            "allOf": [
              {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"},
              {"not": {"const": "fetch_many"}}
            ]
          }
        },
        "required": [
          "tool_id",
          "server_id",
          "name",
          "handler_version",
          "input_schema",
          "output_schema",
          "projection",
          "effect_class",
          "policy",
          "grant_version",
          "max_calls"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "revision",
    "catalog_digest",
    "discovered_at",
    "tools"
  ],
  "type": "object"
}
