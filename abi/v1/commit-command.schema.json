{
  "$id": "https://agent-runtime.dev/abi/v1/commit-command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "agent"
          }
        }
      },
      "then": {
        "required": [
          "source_run_id",
          "phase_grant_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "user"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source_run_id"
              ]
            },
            {
              "required": [
                "phase_grant_id"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "authority_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "command_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "phase_grant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "agent",
        "user"
      ]
    },
    "source_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "transaction_id",
    "operation_id",
    "manifest_digest",
    "authority_ref",
    "source",
    "actor_id",
    "expires_at"
  ],
  "type": "object"
}
