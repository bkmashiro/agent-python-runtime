{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/response.schema.json",
  "title": "Agent Python Runtime RunResult v1",
  "type": "object",
  "additionalProperties": false,

  "required": ["status", "result", "receipts", "metrics", "error"],
  "properties": {
    "status": {"enum": ["ok", "error"]},
    "result": {},
    "capability_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_run_id", "turn_seq", "output_item_seq", "segment_seq", "invocation_id", "invocation_attempt", "execution_id", "executed_code_sha256"],
      "properties": {
        "agent_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "turn_seq": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "output_item_seq": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "segment_seq": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "invocation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "invocation_attempt": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "execution_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "executed_code_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "workspace_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_sha256", "policy", "disposition", "initial_workspace_sha256", "final_workspace_sha256", "final_tree_sha256", "entry_count", "total_bytes"],
      "properties": {
        "schema_version": {"const": "pysolate.workspace-disposition.v1"},
        "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policy": {"enum": ["export_on_success", "export_on_response", "discard"]},
        "disposition": {"enum": ["exported", "discarded"]},
        "initial_workspace_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "final_workspace_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "final_tree_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "entry_count": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "capsule_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "exported"}}},
          "then": {"required": ["capsule_sha256"]},
          "else": {"not": {"required": ["capsule_sha256"]}}
        },
        {
          "if": {"properties": {"policy": {"const": "discard"}}},
          "then": {"properties": {"disposition": {"const": "discarded"}}}
        }
      ]
    },

    "receipts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "run_id", "capability_plan_sha256", "capability", "operation_index", "request_sha256", "outcome"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "capability_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "parent_call_id": {"type": "string", "minLength": 1, "maxLength": 96},
          "approval_request_id": {"type": "string", "pattern": "^apr_[0-9a-f]{64}$"},
          "capability": {"type": "string", "minLength": 1, "maxLength": 128},
          "operation_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["ok", "denied", "error", "timeout"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "claim_level", "document_id", "source_sha256", "occurrence_id", "capability", "dynamic_occurrence", "start_line", "start_column", "end_line", "end_column"],
            "properties": {
              "schema_version": {"const": "pysolate.source-binding.v0"},
              "claim_level": {"const": "source_bound"},
              "document_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "occurrence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "capability": {"type": "string", "minLength": 1, "maxLength": 128},
              "dynamic_occurrence": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "start_line": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "start_column": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "end_line": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "end_column": {"type": "integer", "minimum": 0, "maximum": 4294967295}
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guest_time_ms": {"type": "number", "minimum": 0},
        "capability_calls": {"type": "integer", "minimum": 0},
        "result_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 128},
            "message": {"type": "string", "maxLength": 4096},
            "error_type": {"type": "string", "maxLength": 256},
            "traceback": {"type": "string", "maxLength": 16384}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"receipts": {"minItems": 1}}},
      "then": {"required": ["capability_plan_sha256"]}
    },
    {
      "if": {
        "required": ["workspace_receipt"],
        "properties": {"workspace_receipt": {"properties": {"policy": {"const": "export_on_response"}}}}
      },
      "then": {"properties": {"workspace_receipt": {"properties": {"disposition": {"const": "exported"}}}}}
    },
    {
      "if": {
        "required": ["workspace_receipt"],
        "properties": {
          "status": {"const": "ok"},
          "workspace_receipt": {"properties": {"policy": {"const": "export_on_success"}}}
        }
      },
      "then": {"properties": {"workspace_receipt": {"properties": {"disposition": {"const": "exported"}}}}}
    },
    {
      "if": {
        "required": ["workspace_receipt"],
        "properties": {
          "status": {"const": "error"},
          "workspace_receipt": {"properties": {"policy": {"const": "export_on_success"}}}
        }
      },
      "then": {"properties": {"workspace_receipt": {"properties": {"disposition": {"const": "discarded"}}}}}
    }
  ]
}
