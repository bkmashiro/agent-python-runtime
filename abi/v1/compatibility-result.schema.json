{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/abi/v1/compatibility-result.schema.json",
  "title": "Agent Python Runtime Host compatibility result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer",
    "status",
    "syntax_checked",
    "source_sha256",
    "profile",
    "declared_imports",
    "observed_imports",
    "undeclared_imports",
    "unused_declared_imports",
    "unqualified_imports",
    "indeterminate_reasons",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "analyzer": {"const": "static-agent-imports-v2"},
    "status": {"enum": ["compatible", "unsupported", "indeterminate"]},
    "syntax_checked": {"const": false},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "profile": {"enum": ["base", "numpy-core"]},
    "artifact_sha256": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "declared_imports": {"$ref": "#/$defs/declaredRoots"},
    "observed_imports": {"$ref": "#/$defs/observedRoots"},
    "undeclared_imports": {"$ref": "#/$defs/observedRoots"},
    "unused_declared_imports": {"$ref": "#/$defs/declaredRoots"},
    "unqualified_imports": {"$ref": "#/$defs/observedRoots"},
    "indeterminate_reasons": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dynamic_execution",
          "dynamic_import",
          "import_set_too_large",
          "lexically_ambiguous",
          "non_preamble_import",
          "noncanonical_import",
          "relative_import",
          "source_too_large"
        ]
      }
    },
    "evidence_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"required": ["artifact_sha256"]},
      "then": {"required": ["manifest_sha256"]}
    },
    {
      "if": {"required": ["manifest_sha256"]},
      "then": {"required": ["artifact_sha256"]}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "declaredRoots": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/root"}
    },
    "observedRoots": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/root"}
    }
  }
}
