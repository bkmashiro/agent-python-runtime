{
  "$id": "https://agent-runtime.dev/abi/v1/audit-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "catalog_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "effect_class": {
      "enum": [
        "read_only",
        "reversible",
        "compensatable",
        "irreversible"
      ]
    },
    "error_code": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "handler_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "error",
        "timeout",
        "denied",
        "rolled_back",
        "compensated",
        "irreversible_committed",
        "reconciliation_required"
      ]
    },
    "policy": {
      "enum": [
        "DENY",
        "AUTO_COMMIT",
        "AGENT_COMMIT_REQUIRED",
        "USER_APPROVAL_REQUIRED"
      ]
    },
    "provider_request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "response_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "run_id",
    "transaction_id",
    "operation_id",
    "attempt_id",
    "catalog_digest",
    "tool_id",
    "handler_version",
    "effect_class",
    "policy",
    "manifest_digest",
    "provider_request_digest",
    "request_digest",
    "outcome",
    "observed_at"
  ],
  "type": "object"
}
