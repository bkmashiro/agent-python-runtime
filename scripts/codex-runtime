#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
default_mcp_bin="$repo_root/.artifacts-private/bin/apyrun-mcp"
mcp_bin="${APYRUN_MCP_BIN:-$default_mcp_bin}"
artifact="${APYRUN_ARTIFACT:-}"
manifest="${APYRUN_MANIFEST:-}"
state_dir="${APYRUN_STATE_DIR:-$repo_root/.artifacts-private/codex-mcp}"
max_memory_mib="${APYRUN_MAX_MEMORY_MIB:-512}"
max_cpu_ms="${APYRUN_MAX_CPU_MS:-20000}"
approval_mode="${APYRUN_MCP_APPROVAL_MODE:-prompt}"
codex_bin="${CODEX_BIN:-codex}"

fail() {
  printf 'codex-runtime: %s\n' "$1" >&2
  exit 2
}

require_absolute_safe_path() {
  local name="$1"
  local value="$2"
  [[ -n "$value" && "$value" == /* ]] || fail "$name must be an absolute path"
  case "$value" in
    *\"*|*\\*|*$'\n'*|*$'\r'*) fail "$name contains characters unsafe for a Codex TOML override" ;;
  esac
}

private_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

require_absolute_safe_path APYRUN_ARTIFACT "$artifact"
require_absolute_safe_path APYRUN_MANIFEST "$manifest"
require_absolute_safe_path APYRUN_MCP_BIN "$mcp_bin"
require_absolute_safe_path APYRUN_STATE_DIR "$state_dir"
[[ -f "$artifact" && ! -L "$artifact" ]] || fail "APYRUN_ARTIFACT must be a regular non-symlink file"
[[ -f "$manifest" && ! -L "$manifest" ]] || fail "APYRUN_MANIFEST must be a regular non-symlink file"
[[ "$max_memory_mib" =~ ^[0-9]+$ ]] || fail "APYRUN_MAX_MEMORY_MIB must be an integer"
[[ "$max_cpu_ms" =~ ^[0-9]+$ ]] || fail "APYRUN_MAX_CPU_MS must be an integer"
case "$approval_mode" in
  auto|prompt|writes|approve) ;;
  *) fail "APYRUN_MCP_APPROVAL_MODE must be auto, prompt, writes, or approve" ;;
esac

if [[ ! -x "$mcp_bin" ]]; then
  [[ "$mcp_bin" == "$default_mcp_bin" ]] || fail "APYRUN_MCP_BIN is not executable"
  mkdir -p "$(dirname "$mcp_bin")"
  chmod 700 "$repo_root/.artifacts-private" "$(dirname "$mcp_bin")"
  (cd "$repo_root" && go build -o "$mcp_bin" ./cmd/apyrun-mcp)
  chmod 700 "$mcp_bin"
fi

if [[ ! -e "$state_dir" ]]; then
  mkdir -p "$state_dir"
  chmod 700 "$state_dir"
fi
[[ -d "$state_dir" && ! -L "$state_dir" ]] || fail "APYRUN_STATE_DIR must be a non-symlink directory"
[[ "$(private_mode "$state_dir")" == "700" ]] || fail "APYRUN_STATE_DIR must have mode 0700"

trace_db="$state_dir/trace-$(date -u +%Y%m%dT%H%M%SZ)-$$.sqlite"
require_absolute_safe_path trace_db "$trace_db"

mcp_args="[\"-artifact\",\"$artifact\",\"-manifest\",\"$manifest\",\"-trace-db\",\"$trace_db\",\"-max-memory-mib\",\"$max_memory_mib\",\"-max-cpu-ms\",\"$max_cpu_ms\"]"

exec "$codex_bin" \
  -c "mcp_servers.agent_python_runtime.command=\"$mcp_bin\"" \
  -c "mcp_servers.agent_python_runtime.args=$mcp_args" \
  -c 'mcp_servers.agent_python_runtime.enabled=true' \
  -c 'mcp_servers.agent_python_runtime.required=true' \
  -c 'mcp_servers.agent_python_runtime.enabled_tools=["python_runtime"]' \
  -c "mcp_servers.agent_python_runtime.default_tools_approval_mode=\"$approval_mode\"" \
  -c 'mcp_servers.agent_python_runtime.startup_timeout_sec=30' \
  -c 'mcp_servers.agent_python_runtime.tool_timeout_sec=310' \
  "$@"
