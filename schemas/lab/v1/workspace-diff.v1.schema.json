{
  "$id": "https://agent-runtime.dev/lab/v1/workspace-diff.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded privacy-safe read projection; not authority and not LabStore disk format.",
  "properties": {
    "base_run_id": {
      "pattern": "^(?:|[a-z0-9][a-z0-9._:-]{0,127})$",
      "type": "string"
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "boolean"
              },
              "present": {
                "type": "boolean"
              },
              "sha256": {
                "pattern": "^(?:|sha256:[0-9a-f]{64})$",
                "type": "string"
              },
              "size_bytes": {
                "maximum": 18446744073709551615,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "present",
              "size_bytes",
              "executable",
              "sha256"
            ],
            "type": "object"
          },
          "before": {
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "boolean"
              },
              "present": {
                "type": "boolean"
              },
              "sha256": {
                "pattern": "^(?:|sha256:[0-9a-f]{64})$",
                "type": "string"
              },
              "size_bytes": {
                "maximum": 18446744073709551615,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "present",
              "size_bytes",
              "executable",
              "sha256"
            ],
            "type": "object"
          },
          "kind": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "path": {
            "allOf": [
              {
                "pattern": "^[^/\\\\:][^\\\\:]*$"
              },
              {
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.(/|$)"
                }
              },
              {
                "not": {
                  "pattern": "//"
                }
              }
            ],
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind",
          "before",
          "after"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "generated_at_policy": {
      "const": "omitted"
    },
    "page": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "pattern": "^(?:[A-Za-z0-9_-]{1,128})?$",
          "type": "string"
        },
        "next_cursor": {
          "pattern": "^(?:[A-Za-z0-9_-]{1,128})?$",
          "type": "string"
        },
        "returned": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "cursor",
        "next_cursor",
        "returned",
        "total",
        "truncated"
      ],
      "type": "object"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": "pysolate.workspace-diff.v1"
    },
    "source_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "generated_at_policy",
    "run_id",
    "base_run_id",
    "changes",
    "page"
  ],
  "title": "Pysolate Lab workspace-diff.v1",
  "type": "object"
}
