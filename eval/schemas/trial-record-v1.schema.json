{
  "$id": "https://agent-runtime.dev/eval/v1/trial-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "exclusion": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "excluded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exclusion": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "final_output_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "receipt_bundle_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "transaction_evidence_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scoring": {
            "properties": {
              "task_success": {
                "const": true
              }
            },
            "required": [
              "task_success"
            ]
          }
        },
        "required": [
          "scoring"
        ]
      },
      "then": {
        "properties": {
          "final_output_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "receipt_bundle_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "const": "completed"
          },
          "transaction_evidence_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data_bytes": {
            "maximum": 16777216,
            "minimum": 0,
            "type": "integer"
          },
          "data_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "duration_ms": {
            "maximum": 3600000,
            "minimum": 0,
            "type": "number"
          },
          "identity_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "uniqueItems": true
          },
          "sequence": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          },
          "type": {
            "enum": [
              "trial_started",
              "model_request",
              "model_response",
              "direct_tool_requested",
              "workflow_requested",
              "host_tool_started",
              "host_tool_completed",
              "operation_transition",
              "attempt_transition",
              "rollback_requested",
              "rollback_attempted",
              "compensation_requested",
              "compensation_attempted",
              "transaction_terminal",
              "final_answer",
              "trial_finished"
            ]
          }
        },
        "required": [
          "sequence",
          "type",
          "observed_at",
          "duration_ms",
          "identity_digest",
          "data_digest",
          "data_bytes",
          "reason_codes"
        ],
        "type": "object"
      },
      "maxItems": 1000000,
      "minItems": 2,
      "type": "array"
    },
    "exclusion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "preregistered": {
              "type": "boolean"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason",
            "preregistered"
          ],
          "type": "object"
        }
      ]
    },
    "final_output_bytes": {
      "maximum": 16777216,
      "minimum": 0,
      "type": "integer"
    },
    "final_output_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "format": "date-time",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "direct_calls": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "duplicate_attempts": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "generated_python_bytes": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "host_tool_calls": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "input_tokens": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "intermediate_tokens": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "model_calls": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "model_tool_round_trips": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "python_repair_rounds": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "retries": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "wall_time_ms": {
          "maximum": 3600000,
          "minimum": 0,
          "type": "number"
        },
        "workflow_runs": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "model_calls",
        "model_tool_round_trips",
        "direct_calls",
        "workflow_runs",
        "host_tool_calls",
        "retries",
        "duplicate_attempts",
        "input_tokens",
        "output_tokens",
        "intermediate_tokens",
        "generated_python_bytes",
        "python_repair_rounds",
        "wall_time_ms"
      ],
      "type": "object"
    },
    "provider_exchanges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assistant_message": {
            "additionalProperties": false,
            "properties": {
              "content_bytes": {
                "maximum": 16777216,
                "minimum": 0,
                "type": "integer"
              },
              "content_digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "name": {
                "oneOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant",
                  "tool"
                ]
              },
              "tool_call_id": {
                "oneOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "role",
              "content_digest",
              "content_bytes",
              "name",
              "tool_call_id"
            ],
            "type": "object"
          },
          "finish_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "messages": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "content_bytes": {
                  "maximum": 16777216,
                  "minimum": 0,
                  "type": "integer"
                },
                "content_digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "name": {
                  "oneOf": [
                    {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "role": {
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "tool_call_id": {
                  "oneOf": [
                    {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "role",
                "content_digest",
                "content_bytes",
                "name",
                "tool_call_id"
              ],
              "type": "object"
            },
            "maxItems": 512,
            "minItems": 1,
            "type": "array"
          },
          "model_call_index": {
            "maximum": 128,
            "minimum": 1,
            "type": "integer"
          },
          "request_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "response_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "transport_attempts": {
            "maximum": 17,
            "minimum": 1,
            "type": "integer"
          },
          "transport_errors": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "usage": {
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "total_tokens": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens"
            ],
            "type": "object"
          }
        },
        "required": [
          "model_call_index",
          "request_digest",
          "response_digest",
          "messages",
          "assistant_message",
          "finish_reason",
          "usage",
          "transport_attempts",
          "transport_errors"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "receipt_bundle_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "redaction": {
      "additionalProperties": false,
      "properties": {
        "approval_tokens_recorded": {
          "const": false
        },
        "credentials_recorded": {
          "const": false
        },
        "headers_recorded": {
          "const": false
        },
        "raw_fixture_payload_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "headers_recorded",
        "credentials_recorded",
        "approval_tokens_recorded",
        "raw_fixture_payload_allowed"
      ],
      "type": "object"
    },
    "safety": {
      "additionalProperties": false,
      "properties": {
        "compensation_as_rollback": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "duplicate_committed_effects": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "forged_authority_acceptances": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "irreversible_preapproval_executions": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "stale_catalog_acceptances": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "stronger_terminal_states": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "unauthorized_executions": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unauthorized_executions",
        "irreversible_preapproval_executions",
        "duplicate_committed_effects",
        "compensation_as_rollback",
        "stronger_terminal_states",
        "stale_catalog_acceptances",
        "forged_authority_acceptances"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "evaluation-trial-record/v1"
    },
    "scoring": {
      "additionalProperties": false,
      "properties": {
        "business_state_correct": {
          "type": "boolean"
        },
        "deterministic_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "deterministic_scorer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "failure_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "llm_judge": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "judge_model": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "reason_digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "score": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "judge_model",
                "score",
                "reason_digest"
              ],
              "type": "object"
            }
          ]
        },
        "output_schema_valid": {
          "type": "boolean"
        },
        "task_success": {
          "type": "boolean"
        },
        "terminal_state_truthful": {
          "type": "boolean"
        }
      },
      "required": [
        "task_success",
        "output_schema_valid",
        "business_state_correct",
        "terminal_state_truthful",
        "deterministic_scorer_id",
        "deterministic_score",
        "failure_codes",
        "llm_judge"
      ],
      "type": "object"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout",
        "cancelled",
        "excluded"
      ]
    },
    "transaction_evidence_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trial_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "trial_spec_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trial_id",
    "trial_spec_digest",
    "status",
    "started_at",
    "finished_at",
    "provider_exchanges",
    "events",
    "final_output_digest",
    "final_output_bytes",
    "metrics",
    "safety",
    "scoring",
    "transaction_evidence_digest",
    "receipt_bundle_digest",
    "redaction",
    "exclusion"
  ],
  "type": "object"
}
